# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mg-potdar-jewellers?retryWrites=true&w=majority
MONGO_URI_LOCAL=mongodb://localhost:27017/mg-potdar-jewellers

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=MG Potdar Jewellers <your-email@gmail.com>
EMAIL_REPLY_TO=contact@mgpotdar.com

# File Upload
UPLOAD_PATH=public/uploads
MAX_FILE_SIZE=5000000  # 5MB 